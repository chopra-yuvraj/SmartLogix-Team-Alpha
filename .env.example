# ============================================================
# SmartLogix — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit the .env file — it is in .gitignore.
# ============================================================

# ----------------------------------------------------------
# Supabase (REQUIRED)
# Obtain from: Supabase Dashboard → Project Settings → API
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ----------------------------------------------------------
# OSRM (local self-hosted, required for route optimization)
# Default assumes Docker-based local OSRM from infra/docker-compose.yml
# ----------------------------------------------------------
OSRM_BASE_URL=http://localhost:5000

# ----------------------------------------------------------
# Go Solver Microservice
# ----------------------------------------------------------
SOLVER_HOST=localhost
SOLVER_PORT=8081
SOLVER_BUDGET_MS=500

# ----------------------------------------------------------
# FastAPI Gateway
# ----------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------
# Corridor Clustering Configuration
# ----------------------------------------------------------
CLUSTER_MIN_SHIPMENTS=2
CLUSTER_MAX_WAIT_SECONDS=300

# ----------------------------------------------------------
# Bidding Configuration
# ----------------------------------------------------------
BID_WINDOW_SECONDS=120

# ----------------------------------------------------------
# GLEC Emission Factor
# Reference: GLEC Framework v3.0 — diesel heavy-duty truck
# Unit: kg CO₂e per tonne-km
# ----------------------------------------------------------
GLEC_EF_DIESEL=0.062

# ----------------------------------------------------------
# Web Push (VAPID keys — generated locally)
# Generate with: npx web-push generate-vapid-keys
# ----------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smartlogix.dev

# ----------------------------------------------------------
# MapTiler (OPTIONAL — falls back to free OSM tiles if absent)
# Obtain from: https://www.maptiler.com/cloud/
# ----------------------------------------------------------
NEXT_PUBLIC_MAPTILER_API_KEY=

# ----------------------------------------------------------
# Twilio (OPTIONAL — stubbed if absent, see rules.md §9)
# Obtain from: https://console.twilio.com/
# ----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ----------------------------------------------------------
# Next.js
# ----------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
